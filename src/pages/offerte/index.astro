---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/wrapper/Section.astro';
import ContentWrapper from '@/components/wrapper/ContentWrapper.astro';
import Eyebrow from '@/components/typography/Eyebrow.astro';
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import QuoteWizard from '@/components/interactive/QuoteWizard.astro';
---
<BaseLayout title="Offerte aanvragen" description="Vraag in vier eenvoudige stappen een offerte aan bij Klessens Bouw."><Section space="large"><ContentWrapper size="wide"><div class="intro"><Eyebrow>UW PROJECT BEGINT HIER</Eyebrow><Heading tag="h1">Vertel ons uw plannen.</Heading><Paragraph>Met een paar vragen krijgen we een goed beeld van uw wensen. Daarna nemen we contact met u op.</Paragraph></div><QuoteWizard/></ContentWrapper></Section></BaseLayout>
<style lang="scss">.intro{max-width:56rem;margin:2rem 0 4rem}.intro :global(h1){font-size:clamp(3rem,7vw,6rem);line-height:1.05;letter-spacing:-.05em;margin:1.5rem 0}.intro :global(p){color:var(--text-secondary);line-height:1.8}</style>
