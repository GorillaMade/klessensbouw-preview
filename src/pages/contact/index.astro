---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/wrapper/Section.astro';
import ContentWrapper from '@/components/wrapper/ContentWrapper.astro';
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import Eyebrow from '@/components/typography/Eyebrow.astro';
import Form from '@/components/form/Form.astro';
import Input from '@/components/form/Input.astro';
import Textarea from '@/components/form/Textarea.astro';
import Button from '@/components/Button.astro';
---
<BaseLayout title="Contact" description="Neem contact op met Klessens Bouw."><Section space="large"><ContentWrapper size="wide"><div class="contact-grid"><div><Eyebrow>CONTACT</Eyebrow><Heading tag="h1">Een goed gesprek is het begin.</Heading><Paragraph>Heeft u een vraag of wilt u kennismaken? Laat een bericht achter. Voor een uitgebreide aanvraag kunt u ons stapsgewijze offerteformulier gebruiken.</Paragraph><a class="email" href="mailto:info@klessensbouw.nl">info@klessensbouw.nl ↗</a><Button href="/offerte/" emphasis="secondary">Uitgebreide offerte aanvragen</Button></div><div class="contact-form"><Heading tag="h2">Stuur ons een bericht.</Heading><Form id="contact-form"><Input id="contact-name" name="naam" label="Uw naam" required autocomplete="name"/><Input id="contact-email" name="email" type="email" label="E-mailadres" required autocomplete="email"/><Input id="contact-phone" name="telefoon" type="tel" label="Telefoonnummer (optioneel)"/><Textarea id="contact-message" name="bericht" label="Uw bericht" required rows="6"/><label class="consent"><input type="checkbox" name="akkoord" required/> Ik ga ermee akkoord dat mijn gegevens gebruikt worden om mijn bericht te beantwoorden.</label><Button type="submit">Bericht voorbereiden ↗</Button><Paragraph class="feedback" data-contact-feedback aria-live="polite"></Paragraph></Form></div></div></ContentWrapper></Section></BaseLayout>
<script>document.querySelector<HTMLFormElement>('#contact-form')?.addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;if(!form.reportValidity())return;const data=new FormData(form);const body=encodeURIComponent(Array.from(data.entries()).filter(([k])=>k!=='akkoord').map(([k,v])=>`${k}: ${v}`).join('\n'));const feedback=document.querySelector('[data-contact-feedback]');if(feedback)feedback.textContent='Uw e-mailprogramma wordt geopend. Verstuur de e-mail om uw bericht te verzenden.';location.href=`mailto:info@klessensbouw.nl?subject=${encodeURIComponent('Contact via Klessens Bouw')}&body=${body}`})</script>
<style lang="scss">.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,8vw,9rem);padding:3rem 0}.contact-grid :global(h1){font-size:clamp(3rem,6vw,6rem);line-height:1.05;letter-spacing:-.05em;margin:1.5rem 0 2rem}.contact-grid :global(p){color:var(--text-secondary);line-height:1.8}.email{display:block;font-size:clamp(1rem,2vw,1.5rem);color:var(--text-primary);margin:2rem 0}.contact-form{background:var(--surface-subtle);padding:clamp(1.5rem,4vw,3.5rem)}.contact-form :global(h2){font-size:2rem;margin-bottom:2rem}.consent{display:flex;align-items:start;gap:.7rem;font-size:.85rem;line-height:1.6}.consent input{margin-top:.3rem}@media(max-width:850px){.contact-grid{grid-template-columns:1fr}}</style>
