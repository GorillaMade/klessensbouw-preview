---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/wrapper/Section.astro';
import ContentWrapper from '@/components/wrapper/ContentWrapper.astro';
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import Eyebrow from '@/components/typography/Eyebrow.astro';
import Button from '@/components/Button.astro';
import BeforeAfter from '@/components/interactive/BeforeAfter.astro';
import {projects} from '@/data/projects';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}))}
const {project}=Astro.props;
---
<BaseLayout title={project.title} description={project.description}><Section space="large"><ContentWrapper size="wide"><div class="detail-head"><Eyebrow>CONCEPTPROJECT · {project.category}</Eyebrow><Heading tag="h1">{project.title}</Heading><Paragraph>{project.description}</Paragraph><Paragraph class="concept-note">Dit is een fictief conceptproject met illustratieve sfeerbeelden. De foto’s tonen niet noodzakelijk dezelfde ruimte en zijn geen documentatie van door Klessens Bouw uitgevoerd werk.</Paragraph><Button href="/projecten/" emphasis="secondary">← Alle projecten</Button></div>
{project.cover && <div class="cover"><img src={project.cover} alt={project.title} onerror="this.parentElement.style.display='none'"/></div>}
{project.before && project.after && <div class="compare-block"><Heading tag="h2">Sfeerimpressie: voor & na</Heading><Paragraph>Interactieve conceptvergelijking — geen authentieke verbouwingsregistratie.</Paragraph><BeforeAfter before={project.before} after={project.after} alt={project.title}/></div>}
{project.gallery && project.gallery.length>0 && <div class="gallery">{project.gallery.map((src:string)=><img src={src} alt={`Foto van ${project.title}`} loading="lazy"/>)}</div>}
<div class="detail-cta"><Heading tag="h2">Ook plannen voor uw woning?</Heading><Button href="/offerte/">Offerte aanvragen ↗</Button></div></ContentWrapper></Section></BaseLayout>
<style lang="scss">.concept-note{padding:1rem 1.3rem;border-left:3px solid var(--brand-500);background:var(--surface-subtle);font-size:.9rem}.detail-head{max-width:60rem;padding:3rem 0 4rem}.detail-head :global(h1){font-size:clamp(3rem,7vw,6rem);letter-spacing:-.05em;line-height:1.06;margin:1rem 0}.detail-head :global(p){margin:0 0 2rem;color:var(--text-secondary)}.cover img{width:100%;max-height:650px;object-fit:cover}.compare-block{margin:5rem 0}.compare-block :global(h2){margin-bottom:2rem}.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin:3rem 0}.gallery img{width:100%;height:auto}.detail-cta{margin-top:5rem;border-top:1px solid var(--border-default);padding-top:3rem;display:grid;gap:2rem;justify-items:start}@media(max-width:700px){.gallery{grid-template-columns:1fr}}</style>
