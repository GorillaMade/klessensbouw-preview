---
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import Button from '@/components/Button.astro';
---
<section class="wizard" aria-label="Offerte aanvragen" data-wizard>
 <div class="wizard__aside"><span class="wizard__eyebrow">UW PROJECT / ONZE AANDACHT</span><Heading tag="h2" >Vertel ons wat u voor ogen heeft.</Heading><Paragraph>In een paar korte stappen krijgen we een eerste beeld van uw plannen. Daarna bespreken we samen de mogelijkheden.</Paragraph><div class="wizard__progress"><span data-step-label>STAP 01 VAN 04</span><div class="wizard__track"><div data-progress></div></div></div></div>
 <form class="wizard__form" data-form novalidate>
 <fieldset data-step="0"><legend>Wat wilt u laten uitvoeren?</legend><Paragraph>Waar kunnen we u bij helpen?</Paragraph><div class="wizard__choices"><label><input type="radio" name="projecttype" value="Bouw / verbouw" required/><span>Bouw / verbouw <small>Een nieuwe ruimte of een aanpassing</small></span></label><label><input type="radio" name="projecttype" value="Renovatie"/><span>Renovatie <small>Een bestaande ruimte vernieuwen</small></span></label><label><input type="radio" name="projecttype" value="Onderhoud"/><span>Onderhoud <small>Uw pand in goede conditie houden</small></span></label><label><input type="radio" name="projecttype" value="Anders / advies"/><span>Anders / advies <small>Ik bespreek graag de mogelijkheden</small></span></label></div></fieldset>
 <fieldset data-step="1" hidden><legend>Vertel iets over het project.</legend><label class="wizard__field">Waar vinden de werkzaamheden plaats?<input name="location" type="text" autocomplete="address-level2" placeholder="Plaats / postcode" required /></label><label class="wizard__field">Wat heeft u in gedachten?<textarea name="description" rows="5" placeholder="Beschrijf uw plannen, wensen en eventuele bijzonderheden..." required></textarea></label></fieldset>
 <fieldset data-step="2" hidden><legend>Wat is uw planning?</legend><label class="wizard__field">Wanneer wilt u starten?<select name="planning" required><option value="">Kies een periode</option><option>Zo snel mogelijk</option><option>Binnen 3 maanden</option><option>Binnen 6 maanden</option><option>Later / flexibel</option></select></label><label class="wizard__field">Indicatief budget (optioneel)<select name="budget"><option value="">Nog niet bekend / liever bespreken</option><option>Tot € 5.000</option><option>€ 5.000 – € 15.000</option><option>€ 15.000 – € 35.000</option><option>€ 35.000 – € 75.000</option><option>Vanaf € 75.000</option></select></label></fieldset>
 <fieldset data-step="3" hidden><legend>Hoe kunnen we u bereiken?</legend><div class="wizard__columns"><label class="wizard__field">Naam<input name="name" autocomplete="name" required placeholder="Uw naam" /></label><label class="wizard__field">Telefoonnummer<input name="phone" type="tel" autocomplete="tel" required placeholder="06 ..." /></label></div><label class="wizard__field">E-mailadres<input name="email" type="email" autocomplete="email" required placeholder="naam@voorbeeld.nl" /></label><label class="wizard__consent"><input type="checkbox" name="consent" required/><span>Ik geef toestemming om mijn gegevens te gebruiken voor contact over deze aanvraag.</span></label></fieldset>
 <div class="wizard__error" data-error role="alert" aria-live="polite"></div>
 <div class="wizard__controls"><Button type="button" emphasis="secondary" data-prev>Vorige</Button><Button type="button" data-next>Volgende stap ↗</Button><Button type="submit" data-submit hidden>Offerteaanvraag voorbereiden ↗</Button></div>
 <Paragraph  class="wizard__note">Na de laatste stap opent uw e-mailprogramma met de ingevulde aanvraag. Er worden nog geen gegevens via deze website verstuurd.</Paragraph>
 </form>
</section>
<script>
 const root=document.querySelector<HTMLElement>('[data-wizard]');
 if(root){
 const form=root.querySelector<HTMLFormElement>('[data-form]')!;
 const steps=Array.from(root.querySelectorAll<HTMLFieldSetElement>('[data-step]'));
 const next=root.querySelector<HTMLButtonElement>('[data-next]')!;
 const prev=root.querySelector<HTMLButtonElement>('[data-prev]')!;
 const submit=root.querySelector<HTMLButtonElement>('[data-submit]')!;
 const error=root.querySelector<HTMLElement>('[data-error]')!;
 const label=root.querySelector<HTMLElement>('[data-step-label]')!;
 const progress=root.querySelector<HTMLElement>('[data-progress]')!;
 let current=0;
 const render=()=>{steps.forEach((s,i)=>{s.hidden=i!==current;s.disabled=i!==current});prev.hidden=current===0;next.hidden=current===steps.length-1;submit.hidden=current!==steps.length-1;label.textContent=`STAP 0${current+1} VAN 0${steps.length}`;progress.style.width=`${(current+1)/steps.length*100}%`;error.textContent=''};
 const validate=()=>{const inputs=Array.from(steps[current].querySelectorAll<HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>('input,textarea,select'));for(const input of inputs){if(!input.checkValidity()){error.textContent='Vul de verplichte velden in om verder te gaan.';input.focus();return false}}return true};
 next.addEventListener('click',()=>{if(validate()){current=Math.min(current+1,steps.length-1);render()}});
 prev.addEventListener('click',()=>{current=Math.max(current-1,0);render()});
 form.addEventListener('submit',(e)=>{e.preventDefault();if(!validate())return;const data=new FormData(form);const get=(name:string)=>String(data.get(name)||'Niet opgegeven');const subject='Offerteaanvraag via website Klessens Bouw';const body=`Nieuwe offerteaanvraag\n\nWerkzaamheden: ${get('projecttype')}\nLocatie: ${get('location')}\nOmschrijving: ${get('description')}\nPlanning: ${get('planning')}\nBudget: ${get('budget')}\n\nNaam: ${get('name')}\nTelefoon: ${get('phone')}\nE-mail: ${get('email')}`;window.location.href=`mailto:info@klessensbouw.nl?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;error.textContent='Uw e-mailprogramma wordt geopend. Controleer en verstuur daar de aanvraag.'});render();
 }
</script>
<style lang="scss">
.wizard{display:grid;grid-template-columns:.85fr 1.15fr;min-height:40rem;border:1px solid var(--border-default);background:var(--surface-page)}.wizard__aside{background:var(--neutral-900);color:var(--neutral-100);padding:clamp(2rem,5vw,5rem);display:flex;flex-direction:column;align-items:start}.wizard__aside :global(.heading){color:inherit;margin:2rem 0}.wizard__aside :global(.text){color:var(--neutral-200);line-height:1.8}.wizard__eyebrow,.wizard__progress{font-size:.7rem;letter-spacing:.16em}.wizard__progress{margin-top:auto;width:100%;padding-top:4rem}.wizard__track{height:2px;background:var(--neutral-700);margin-top:1rem}.wizard__track>div{height:100%;width:25%;background:var(--brand-400);transition:width .3s}.wizard__form{padding:clamp(2rem,5vw,5rem);display:flex;flex-direction:column}.wizard__form fieldset{border:0;margin:0;padding:0;min-width:0}.wizard__form fieldset[hidden]{display:none}.wizard__form legend{font-family:var(--font-heading);font-size:clamp(1.8rem,3vw,2.7rem);font-weight:600;letter-spacing:-.035em;line-height:1.2;margin-bottom:1.5rem}.wizard__form :global(.text){color:var(--text-secondary)}.wizard__choices{display:grid;gap:.7rem;margin-top:2rem}.wizard__choices label{cursor:pointer}.wizard__choices input{position:absolute;opacity:0}.wizard__choices label>span{display:block;padding:1rem 1.2rem;border:1px solid var(--border-default);font-weight:600;transition:border-color .2s,background .2s}.wizard__choices small{display:block;font-size:.8rem;font-weight:400;color:var(--text-secondary);margin-top:.3rem}.wizard__choices input:checked+span{border-color:var(--brand-600);background:var(--brand-100)}.wizard__choices input:focus-visible+span{outline:2px solid var(--brand-700);outline-offset:2px}.wizard__field{display:grid;gap:.6rem;font-size:.9rem;font-weight:600;margin-bottom:1.4rem}.wizard__field input,.wizard__field textarea,.wizard__field select{width:100%;border:1px solid var(--border-default);background:var(--surface-page);padding:1rem;font:inherit;color:var(--text-primary);border-radius:0;font-weight:400}.wizard__field :is(input,textarea,select):focus{outline:2px solid var(--brand-600);outline-offset:1px}.wizard__columns{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.wizard__consent{display:flex;align-items:start;gap:.8rem;font-size:.85rem;line-height:1.5;margin-top:1rem}.wizard__consent input{margin-top:.25rem;accent-color:var(--brand-700)}.wizard__controls{display:flex;justify-content:space-between;gap:1rem;margin-top:auto;padding-top:2rem}.wizard__controls [hidden]{display:none}.wizard__error{color:var(--brand-800);font-size:.85rem;margin-top:1rem;min-height:1.5rem}.wizard__note{font-size:.75rem;margin-top:1.3rem;line-height:1.6}@media(max-width:800px){.wizard{grid-template-columns:1fr}.wizard__aside{min-height:22rem}.wizard__columns{grid-template-columns:1fr}}
</style>
