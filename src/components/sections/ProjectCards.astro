---
import {projects} from '@/data/projects';
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
---
<div class="projects">{projects.map((project,i)=><a href={`/projecten/${project.slug}/`} class="project"><div class="project__media">{project.cover && <img src={project.cover} alt={project.title} loading="lazy" onerror="this.style.display='none'"/>}<span class="project__fallback">KLESSENS BOUW <small>PROJECT {String(i+1).padStart(2,'0')}</small></span></div><div class="project__meta"><div><span>{project.category} · CONCEPT</span><Heading tag="h3">{project.title}</Heading></div><span aria-hidden="true">↗</span></div></a>)}</div>
<style lang="scss">
.projects{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(2rem,4vw,4rem)}.project{text-decoration:none;color:var(--text-primary)}.project__media{aspect-ratio:5/4;background:var(--neutral-200);position:relative;overflow:hidden}.project__media img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0;z-index:2;transition:transform .6s}.project:hover img{transform:scale(1.035)}.project__fallback{position:absolute;inset:0;display:grid;place-content:center;text-align:center;gap:1rem;letter-spacing:.2em;color:var(--neutral-600);font-weight:700}.project__fallback small{font-weight:400;font-size:.65rem}.project__meta{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding-top:1.2rem;border-top:1px solid var(--border-default);margin-top:1rem}.project__meta span{font-size:.75rem;letter-spacing:.15em;color:var(--text-muted)}.project__meta :global(h3){font-size:clamp(1.2rem,2vw,1.7rem);margin-top:.4rem}@media(max-width:700px){.projects{grid-template-columns:1fr}}
</style>
