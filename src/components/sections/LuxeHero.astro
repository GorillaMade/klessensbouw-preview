---
import Heading from '@/components/typography/Heading.astro';
import Paragraph from '@/components/typography/Paragraph.astro';
import Eyebrow from '@/components/typography/Eyebrow.astro';
import Button from '@/components/Button.astro';
---
<section class="lux-hero"><div class="lux-hero__photo" role="img" aria-label="Sfeervol architectonisch interieur"></div><div class="lux-hero__copy"><Eyebrow>BOUW · ONDERHOUD · RENOVATIE</Eyebrow><Heading tag="h1">Ruimte voor bijzonder werk.</Heading><Paragraph>Uw plannen verdienen aandacht. Van de eerste schets tot de laatste afwerking realiseren wij ruimtes waarin kwaliteit voelbaar is.</Paragraph><div class="lux-hero__actions"><Button href="/offerte/">Vraag een offerte aan ↗</Button><Button href="/projecten/" emphasis="secondary">Bekijk projecten</Button></div><span class="lux-hero__index">KLESSENS BOUW — MET ZORG GEMAAKT</span></div></section>
<style lang="scss">
.lux-hero{display:grid;grid-template-columns:1.08fr 1fr;min-height:760px;min-height:min(810px,85svh);background:var(--surface-page)}.lux-hero__photo{background:linear-gradient(0deg,rgba(30,30,30,.16),transparent),url("https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1600&q=85") center/cover;min-height:450px}.lux-hero__copy{display:flex;flex-direction:column;justify-content:center;align-items:start;padding:clamp(2rem,6vw,7rem)}.lux-hero__copy :global(h1){font-size:clamp(3.5rem,6.5vw,7.5rem);letter-spacing:-.055em;line-height:1.03;font-weight:450;max-width:11ch;margin:2rem 0}.lux-hero__copy :global(p){max-width:48ch;line-height:1.85;color:var(--text-secondary)}.lux-hero__actions{display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem}.lux-hero__index{font-size:.65rem;letter-spacing:.2em;margin-top:auto;padding-top:4rem;color:var(--text-muted)}@media(max-width:900px){.lux-hero{grid-template-columns:1fr}.lux-hero__photo{min-height:360px;order:2}.lux-hero__copy{min-height:490px}}
</style>
